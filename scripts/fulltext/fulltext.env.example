# Full-text store config. Copy to fulltext.env (gitignored) and edit.
#
#   cp scripts/fulltext/fulltext.env.example scripts/fulltext/fulltext.env
#
# This file is IDENTICAL across all three LLM-wiki projects: the per-project
# Drive subfolder is derived automatically from the repo name, so you do not edit
# a folder name here.
#
# RCLONE_REMOTE: name of the rclone remote (type: drive) created with
#   `scripts/fulltext/bin/rclone config`. The same remote / Drive account is
#   shared by all three projects. Example: gdrive
# FULLTEXT_ROOT: shared parent folder on that Drive. Each project stores under
#   <FULLTEXT_ROOT>/<project-label>/ (label derived from the repo dir name), so
#   the three projects live in distinct sibling subfolders of one parent.
#
# Advanced (rarely needed):
#   FULLTEXT_PROJECT=<label>   # override the derived subfolder label
#   DRIVE_FOLDER=<path>        # bypass derivation entirely (full Drive path)

RCLONE_REMOTE=gdrive
FULLTEXT_ROOT=LLM-Wiki-Fulltext
